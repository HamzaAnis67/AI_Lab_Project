{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "app.js",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/app.js",
      "dest": "/app.js"
    }
  ],
  "env": {
    "BACKEND_URL": "https://ai-lab-project-u0i0.onrender.com"
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://ai-lab-project-u0i0.onrender.com/$1"
    }
  ]
}
